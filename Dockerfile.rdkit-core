# PostgreSQL-independent RDKit compile, shared by every PostgreSQL major built
# for the same {rdkit_version, debian_version}. The main Dockerfile copies the
# source tree, the compiled build tree and the CMake toolchain out of this
# image and only reconfigures with RDK_BUILD_PGSQL=ON.
#
# source_dir, build_dir, install_dir and cmake_install_dir must stay identical
# to the main Dockerfile's defaults of the same names: CMake caches absolute
# paths, and any difference invalidates the whole tree.
ARG debian_version=bookworm
ARG rdkit_version=2026_03_6
ARG rdkit_repo=https://github.com/rdkit/rdkit.git
ARG rdkit_branch_name=Release_${rdkit_version}
ARG source_dir=/tmp/rdkit
ARG build_dir=/tmp/rdkit-build
ARG install_dir=/opt/rdkit
ARG cmake_version=3.28.3
ARG cmake_install_dir=/opt/cmake
ARG num_build_cores=4

# Where the finished build tree lands as a normal image layer. ${build_dir}
# itself is a cache mount below, which `COPY --from=` in the main Dockerfile
# could not reach, so the tree is exported to this sibling path and copied
# back into ${build_dir} on the consuming side. CMake's cached paths stay
# /tmp/rdkit-build on both sides.
ARG build_export_dir=/tmp/rdkit-build-export
ARG DEBIAN_FRONTEND=noninteractive

FROM docker.io/debian:${debian_version}-slim AS rdkit-core
ARG rdkit_repo
ARG rdkit_branch_name
ARG source_dir
ARG build_dir
ARG install_dir
ARG cmake_version
ARG cmake_install_dir
ARG num_build_cores
ARG build_export_dir
ARG rdkit_version
ARG debian_version
ARG DEBIAN_FRONTEND

RUN apt-get update \
    && apt-get install -yq --no-install-recommends \
        build-essential ca-certificates curl git \
        libeigen3-dev libfreetype6-dev zlib1g-dev libbz2-dev

RUN git clone --depth=1 --branch=${rdkit_branch_name} ${rdkit_repo} ${source_dir}

COPY scripts/install_boost.sh /usr/local/bin/install_boost.sh
RUN install_boost.sh ${source_dir} > /tmp/boost-version.txt \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN curl -L https://github.com/Kitware/CMake/releases/download/v${cmake_version}/cmake-${cmake_version}-linux-x86_64.sh -o /tmp/cmake.sh \
    && mkdir -p ${cmake_install_dir} \
    && sh /tmp/cmake.sh --skip-license --prefix=${cmake_install_dir} \
    && ln -s ${cmake_install_dir}/bin/cmake /usr/local/bin/cmake \
    && ln -s ${cmake_install_dir}/bin/ctest /usr/local/bin/ctest \
    && rm -f /tmp/cmake.sh

# ${build_dir} is a cache mount so an interrupted `make core` resumes from the
# already-compiled objects instead of restarting a ~25-minute compile. The
# mount id omits postgres_major_version: this compile is PostgreSQL-independent.
#
# The flag list must match the main Dockerfile's except for RDK_BUILD_PGSQL
# (OFF here) and the PostgreSQL_* variables (absent here). See the main
# Dockerfile for why CHEMDRAW is off and why External/ is on the include path.
RUN --mount=type=cache,target=${build_dir},id=rdkit-build-${rdkit_version}-${debian_version} \
    cmake \
    -D RDK_BUILD_CAIRO_SUPPORT=OFF \
    -D RDK_BUILD_INCHI_SUPPORT=ON \
    -D RDK_BUILD_AVALON_SUPPORT=ON \
    -D RDK_BUILD_PYTHON_WRAPPERS=OFF \
    -D RDK_BUILD_COORDGEN_SUPPORT=OFF \
    -D RDK_BUILD_MAEPARSER_SUPPORT=OFF \
    -D RDK_BUILD_DESCRIPTORS3D=OFF \
    -D RDK_BUILD_FREESASA_SUPPORT=OFF \
    -D RDK_BUILD_MOLINTERCHANGE_SUPPORT=OFF \
    -D RDK_BUILD_YAEHMOP_SUPPORT=OFF \
    -D RDK_BUILD_STRUCTCHECKER_SUPPORT=OFF \
    -D RDK_BUILD_CHEMDRAW_SUPPORT=OFF \
    -D RDK_INSTALL_COMIC_FONTS=OFF \
    -D RDK_USE_URF=OFF \
    -D RDK_BUILD_PGSQL=OFF \
    -D RDK_PGSQL_STATIC=ON \
    -D RDK_INSTALL_INTREE=OFF \
    -D CMAKE_INSTALL_PREFIX=${install_dir} \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS=-I${source_dir}/External \
    -S ${source_dir} \
    -B ${build_dir}

WORKDIR ${build_dir}
# -j on the command line rather than through a MAKEFLAGS ARG: a global ARG
# default cannot see this stage's ARG, so the value would reach make as a
# literal, which it parses as an unlimited `-j`.
RUN --mount=type=cache,target=${build_dir},id=rdkit-build-${rdkit_version}-${debian_version} \
    make -j${num_build_cores}

# Export the finished tree out of the cache mount into a normal image layer.
RUN --mount=type=cache,target=${build_dir},id=rdkit-build-${rdkit_version}-${debian_version} \
    mkdir -p ${build_export_dir} && cp -a ${build_dir}/. ${build_export_dir}/
